# Copie para .env.local ou use: vercel env pull .env.local
# Nunca commite valores reais. Na Vercel, marque os secrets como Sensitive.

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Criptografia AES-256-GCM (32 bytes em hex, 64 caracteres) ---
# Obrigatória em produção: sem ela o registro de HD falha em vez de gravar texto claro.
ENCRYPTION_KEY=

# --- Logtail / Better Stack ---
LOGTAIL_SOURCE_TOKEN=

# --- Rate limit (Upstash Redis) ---
# Sem essas duas variáveis o rate limit NÃO desliga: ele cai para um limitador em
# memória, por instância serverless. Isso segura brute force numa instância quente,
# mas não é distribuído — o limite efetivo vira (limite x instâncias ativas).
# Configure o Upstash para ter um freio real e compartilhado entre instâncias.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
# Sem default no código: se estiver vazia, ninguém vira admin por e-mail.
# Defina na Vercel OU rode: update public.profiles set role = 'admin' where id = '...';
PORTFOLIO_ADMIN_EMAIL=
PLAN_MAX_HDS=1

# --- R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Segundos de validade do link de download. Default 1800 (30 min), teto 21600 (6 h).
R2_SIGNED_URL_TTL=

# --- Stripe ---
# Secret key padrão (sk_test_ ou sk_live_). NÃO use restricted key (rk_) nem publishable (pk_).
STRIPE_SECRET_KEY=
# Legado (opcional): equivale a STRIPE_PRICE_1M_SUB
STRIPE_PRICE_ID=
# Cartão recorrente
STRIPE_PRICE_1M_SUB=
STRIPE_PRICE_2M_SUB=
STRIPE_PRICE_3M_SUB=
# PIX à vista (one-time)
STRIPE_PRICE_1M_PIX=
STRIPE_PRICE_2M_PIX=
STRIPE_PRICE_3M_PIX=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTIONS_ENABLED=
# Libera o acervo inteiro sem assinatura. Só "true" abre; sem isso, assinaturas
# desabilitadas (ou env do Stripe faltando) bloqueiam o manifest.
ACERVO_ABERTO=

# --- Tokens HMAC do app desktop ---
MANIFEST_TOKEN_SECRET=

# Login e cadastro passam por POST /api/auth/* (rate limit no servidor).
# Depois de aplicar supabase/migrations/20260829220000_profiles_role_and_password.sql,
# promova o admin: update public.profiles set role = 'admin' where id = '<uuid>';
