# Copie para .env.local ou use: vercel env pull .env.local
# Nunca commite valores reais. Na Vercel, marque os secrets como Sensitive.

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Criptografia AES-256-GCM (32 bytes em hex, 64 caracteres) ---
ENCRYPTION_KEY=

# --- Logtail / Better Stack ---
LOGTAIL_SOURCE_TOKEN=

# --- Rate limit (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
PORTFOLIO_ADMIN_EMAIL=
PLAN_MAX_HDS=1

# --- R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTIONS_ENABLED=
STRIPE_PLAN_LABEL=R$ 49,90

# --- Tokens HMAC do app desktop ---
MANIFEST_TOKEN_SECRET=
