{
  "name": "montahd-desktop",
  "version": "0.6.11",
  "private": true,
  "author": "MontaHD",
  "description": "Baixa arquivos de um manifesto e organiza no HD",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64"
  },
  "build": {
    "appId": "com.montahd.desktop",
    "productName": "MontaHD",
    "copyright": "Copyright © 2026 MontaHD",
    "icon": "build/icon.png",
    "directories": {
      "output": "release21"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "!**/*.map",
      "!**/*.test.js"
    ],
    "asarUnpack": [
      "renderer/**/*"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "MontaHD"
      }
    },
    "publish": {
      "provider": "generic",
      "url": "https://montahd.vercel.app/downloads"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "MontaHD",
      "uninstallDisplayName": "MontaHD",
      "artifactName": "MontaHD-${version}-setup.exe",
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "MontaHD",
        "schemes": [
          "montahd"
        ]
      }
    ],
    "portable": {
      "artifactName": "MontaHD-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^35.0.0",
    "electron-builder": "^26.15.7",
    "typescript": "^5"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1"
  }
}
