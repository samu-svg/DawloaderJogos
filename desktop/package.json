{
  "name": "montahd-desktop",
  "version": "0.5.4",
  "private": true,
  "description": "Baixa arquivos de um manifesto e organiza no HD",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.montahd.desktop",
    "productName": "MontaHD",
    "icon": "build/icon.png",
    "directories": {
      "output": "release16"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "MontaHD",
      "uninstallDisplayName": "MontaHD",
      "artifactName": "MontaHD-${version}-setup.exe"
    },
    "protocols": [
      {
        "name": "MontaHD",
        "schemes": [
          "montahd"
        ]
      }
    ],
    "portable": {
      "artifactName": "MontaHD-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  }
}
