{
  "name": "dawloader-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Baixa arquivos de um manifesto e organiza no HD",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.dawloader.desktop",
    "productName": "Dawloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5"
  }
}
